/* 暖黄色，与项目主色调一致 */
/* 品牌棕色，统一视觉 */
.detail-page.data-v-a0d09b10 {
  min-height: 100vh;
  background: #fffef7;
  color: #5a2c12;
  padding-bottom: 0;
}
/* 顶部媒体模块（蓝色背景容器） */
.media-wrap.data-v-a0d09b10 {
  margin: 16rpx 16rpx 10rpx;
  padding: 16rpx;
  background: #fff5dc;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.1);
  position: relative;
}
.media.data-v-a0d09b10 {
  width: 100%;
  height: 42vh;
  /* 下调视频高度，页面更紧凑 */
  border-radius: 16rpx;
  object-fit: cover;
  display: block;
  background: #0003;
}
.media-webview.data-v-a0d09b10 {
  border-radius: 16rpx;
  overflow: hidden;
}
/* 绿色名称条 */
.name-bar.data-v-a0d09b10 {
  margin: 12rpx 16rpx 16rpx;
  padding: 24rpx 22rpx;
  background: #7A4E2D;
  color: #fff;
  text-align: center;
  /* 名称文字居中 */
  border-radius: 20rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.1);
}
.heritage-name.data-v-a0d09b10 {
  font-size: 32rpx;
  font-weight: 700;
}
/* 内容卡片（延续白底圆角+柔和阴影） */
.section.data-v-a0d09b10 {
  margin: 12rpx 16rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}
.section-title-row.data-v-a0d09b10 {
  padding: 20rpx 22rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.section-title.data-v-a0d09b10 {
  font-size: 36rpx;
  font-weight: 600;
  color: #5a2c12;
}
.section-share-icon.data-v-a0d09b10 {
  width: auto;
  height: auto;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  border: none;
  line-height: 1;
  /* 微信小程序 button 样式重置 */
  background-color: transparent;
}
.section-share-icon.data-v-a0d09b10::after {
  border: none;
}
.section-share-icon-img.data-v-a0d09b10 {
  width: 48rpx;
  height: 48rpx;
}
.section-body.data-v-a0d09b10 {
  padding: 0 22rpx 22rpx;
}
.section-text.data-v-a0d09b10 {
  display: block;
  /* 设为块级，确保首行缩进生效 */
  font-size: 28rpx;
  line-height: 1.7;
  color: #6b4a2e;
  text-indent: 2em;
  /* 首行缩进 */
}
/* 底部操作按钮 */
.action-buttons.data-v-a0d09b10 {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 16rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fffef7;
}
.action-btn.data-v-a0d09b10 {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.1);
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s;
}
.action-btn.disabled.data-v-a0d09b10 {
  opacity: 0.6;
  pointer-events: none;
}
/* 已体验按钮 */
.experience-btn.data-v-a0d09b10 {
  background: #fff;
  color: #5a2c12;
  border: 3rpx solid #cfa86a;
}
.experience-btn.active.data-v-a0d09b10 {
  background: #7A4E2D;
  color: #fff;
  border-color: #7A4E2D;
}
/* 收藏按钮 */
.favorite-btn.data-v-a0d09b10 {
  background: #fff;
  color: #5a2c12;
  border: 3rpx solid #FFD666;
}
.favorite-btn.active.data-v-a0d09b10 {
  background: #FFD666;
  color: #5a2c12;
  border-color: #FFC94D;
}
.btn-icon.data-v-a0d09b10 {
  font-size: 32rpx;
  line-height: 1;
}
.btn-text.data-v-a0d09b10 {
  font-size: 28rpx;
  font-weight: 600;
}
