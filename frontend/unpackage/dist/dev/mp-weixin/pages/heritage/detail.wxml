<view class="detail-page data-v-a0d09b10"><view class="media-wrap data-v-a0d09b10"><block wx:if="{{media.type==='video'}}"><video class="media data-v-a0d09b10" src="{{media.src}}" controls="{{true}}" poster="{{poster}}" enable-progress-gesture="{{true}}" show-progress="{{true}}" show-fullscreen-btn="{{true}}" data-event-opts="{{[['error',[['onVideoError',['$event']]]]]}}" binderror="__e"></video></block><block wx:else><block wx:if="{{media.type==='webview'}}"><web-view class="media media-webview data-v-a0d09b10" src="{{media.src}}"></web-view></block><block wx:else><image class="media data-v-a0d09b10" src="{{media.src}}" mode="aspectFill" lazy-load="{{true}}"></image></block></block></view><view class="name-bar data-v-a0d09b10"><text class="heritage-name data-v-a0d09b10">{{detail.name}}</text></view><view class="section history data-v-a0d09b10"><view class="section-title-row data-v-a0d09b10"><text class="section-title data-v-a0d09b10">历史渊源</text><button class="section-share-icon data-v-a0d09b10" open-type="share" data-event-opts="{{[['tap',[['onShareClick',['$event']]]]]}}" catchtap="__e"><image class="section-share-icon-img data-v-a0d09b10" src="{{IMG.shareIcon2}}" mode="aspectFit"></image></button></view><view class="section-body data-v-a0d09b10"><text class="section-text data-v-a0d09b10">{{detail.history||'暂无介绍'}}</text></view></view><view class="section content data-v-a0d09b10"><view class="section-title data-v-a0d09b10">内容介绍</view><view class="section-body data-v-a0d09b10"><text class="section-text data-v-a0d09b10">{{detail.desc||'暂无介绍'}}</text></view></view><view class="action-buttons data-v-a0d09b10"><view data-event-opts="{{[['tap',[['handleExperience',['$event']]]]]}}" class="{{['action-btn','experience-btn','data-v-a0d09b10',(isExperienced)?'active':'',(loading)?'disabled':'']}}" bindtap="__e"><text class="btn-icon data-v-a0d09b10">{{isExperienced?'✓':'○'}}</text><text class="btn-text data-v-a0d09b10">{{isExperienced?'已体验':'标记已体验'}}</text></view><view data-event-opts="{{[['tap',[['handleFavorite',['$event']]]]]}}" class="{{['action-btn','favorite-btn','data-v-a0d09b10',(isFavorited)?'active':'',(loading)?'disabled':'']}}" bindtap="__e"><text class="btn-icon data-v-a0d09b10">{{isFavorited?'★':'☆'}}</text><text class="btn-text data-v-a0d09b10">{{isFavorited?'已收藏':'收藏'}}</text></view></view><canvas class="poster-canvas data-v-a0d09b10" style="width:375px;height:640px;position:fixed;left:-9999px;top:-9999px;" canvas-id="heritagePosterCanvas"></canvas></view>