<view class="must-eat-page data-v-4cb9eaeb"><view class="banner data-v-4cb9eaeb"><image class="banner-bg data-v-4cb9eaeb" src="{{heroBg}}" mode="aspectFill"></image><view class="banner-overlay data-v-4cb9eaeb"><view class="banner-content data-v-4cb9eaeb"><view class="city-row data-v-4cb9eaeb"><view class="city-title-block data-v-4cb9eaeb"><text class="city-name data-v-4cb9eaeb">{{cityInfo.name}}</text><view class="city-underline data-v-4cb9eaeb"></view></view></view></view></view></view><block wx:if="{{fetchError}}"><view class="error-tip data-v-4cb9eaeb"><text class="data-v-4cb9eaeb">{{fetchError}}</text></view></block><view class="card-list data-v-4cb9eaeb"><block wx:for="{{foods}}" wx:for-item="food" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['openFoodDetail',['$0'],[[['foods','id',food.id]]]]]]]}}" class="food-card-simple data-v-4cb9eaeb" bindtap="__e"><image class="food-img-simple data-v-4cb9eaeb" src="{{food.cover}}" mode="aspectFill"></image><view class="food-simple-info data-v-4cb9eaeb"><text class="food-name-simple data-v-4cb9eaeb">{{food.name}}</text><block wx:if="{{food.cityBadge}}"><view class="city-badge-pill data-v-4cb9eaeb">{{food.cityBadge}}</view></block></view></view></block></view><block wx:if="{{showFoodDetailDialog&&activeFood}}"><view data-event-opts="{{[['tap',[['closeFoodDetailDialog',['$event']]]]]}}" class="detail-mask data-v-4cb9eaeb" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="detail-content data-v-4cb9eaeb" catchtap="__e"><view class="food-card data-v-4cb9eaeb"><image class="food-img data-v-4cb9eaeb" src="{{activeFood.cover}}" mode="aspectFill"></image><view class="food-body data-v-4cb9eaeb"><view class="food-header data-v-4cb9eaeb"><text class="food-name data-v-4cb9eaeb">{{activeFood.name}}</text><block wx:if="{{activeFood.cityBadge}}"><view class="city-badge-pill data-v-4cb9eaeb">{{activeFood.cityBadge}}</view></block></view><block wx:if="{{$root.g0}}"><view class="highlight-tags data-v-4cb9eaeb"><block wx:for="{{activeFood.highlights}}" wx:for-item="tag" wx:for-index="__i1__" wx:key="*this"><view class="highlight-tag data-v-4cb9eaeb">{{''+tag+''}}</view></block></view></block><view class="food-meta data-v-4cb9eaeb"><view class="food-meta-left data-v-4cb9eaeb"><view class="rating data-v-4cb9eaeb"><text class="rating-label data-v-4cb9eaeb">推荐指数</text><view class="stars data-v-4cb9eaeb"><block wx:for="{{5}}" wx:for-item="dummy" wx:for-index="idx" wx:key="idx"><text class="{{['star','data-v-4cb9eaeb',(idx<activeFood.scoreStars)?'star--active':'']}}">★</text></block></view></view><block wx:if="{{activeFood.heatLabel}}"><view class="heat-pill data-v-4cb9eaeb">{{activeFood.heatLabel}}</view></block></view><button class="{{['card-share-icon','data-v-4cb9eaeb',(activeFood._hasShared)?'card-share-icon--disabled':'']}}" open-type="share" data-event-opts="{{[['tap',[['onShareFoodClick',['$0'],['activeFood']]]]]}}" catchtap="__e"><image class="card-share-icon-img data-v-4cb9eaeb" src="{{IMG.shareIcon}}" mode="aspectFit"></image></button></view><view class="meta-grid data-v-4cb9eaeb"><view class="meta-item data-v-4cb9eaeb"><text class="meta-label data-v-4cb9eaeb">人均</text><text class="meta-value data-v-4cb9eaeb">{{activeFood.perCapita}}</text></view><view class="meta-item data-v-4cb9eaeb"><text class="meta-label data-v-4cb9eaeb">搭配</text><text class="meta-value data-v-4cb9eaeb">{{activeFood.pairing}}</text></view></view><block wx:if="{{activeFood.sceneTag}}"><view class="guide-row data-v-4cb9eaeb"><text class="guide-title data-v-4cb9eaeb">适配场景</text><text class="guide-text data-v-4cb9eaeb">{{activeFood.sceneTag}}</text></view></block><block wx:if="{{activeFood.avoidPit}}"><view class="guide-row data-v-4cb9eaeb"><text class="guide-title data-v-4cb9eaeb">避坑提醒</text><text class="guide-text data-v-4cb9eaeb">{{activeFood.avoidPit}}</text></view></block><block wx:if="{{activeFood.recommendShop}}"><view class="guide-row data-v-4cb9eaeb"><text class="guide-title data-v-4cb9eaeb">推荐店铺</text><text class="guide-text data-v-4cb9eaeb">{{activeFood.recommendShop}}</text></view></block></view></view></view></view></block><block wx:if="{{loading}}"><view class="loading data-v-4cb9eaeb">{{"正在更新"+cityInfo.name+"榜单..."}}</view></block><block wx:else><block wx:if="{{$root.g1===0}}"><view class="empty data-v-4cb9eaeb">暂无上榜餐厅，稍后再来看看</view></block></block><canvas class="poster-canvas data-v-4cb9eaeb" style="width:375px;height:700px;position:fixed;left:-9999px;top:-9999px;" canvas-id="mustEatPosterCanvas"></canvas></view>