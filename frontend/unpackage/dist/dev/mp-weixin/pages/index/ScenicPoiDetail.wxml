{{true}}" data-event-opts="{{[['input',[['__set_model',['','addToListNote','$event',[]]]]]]}}" value="{{addToListNote}}" bindinput="__e"></textarea></view><view class="dialog-actions data-v-4cbe6322"><view data-event-opts="{{[['tap',[['closeAddToListDialog',['$event']]]]]}}" class="dialog-btn cancel data-v-4cbe6322" bindtap="__e">取消</view><view data-event-opts="{{[['tap',[['confirmAddToList',['$event']]]]]}}" class="dialog-btn confirm data-v-4cbe6322" bindtap="__e">确定</view></view></view></view></block><view class="bottom-bar data-v-4cbe6322"><view class="bottom-left data-v-4cbe6322"><view data-event-opts="{{[['tap',[['toggleFavorite',['$event']]]]]}}" class="{{['bottom-icon-item','data-v-4cbe6322',(isFavorited)?'bottom-icon-item--active':'']}}" bindtap="__e"><image class="{{['bottom-icon-img','data-v-4cbe6322',(isFavorited)?'bottom-icon-img--active':'']}}" src="/static/assets/收藏.png" mode="aspectFit"></image><text class="bottom-label data-v-4cbe6322">{{isFavorited?'已收藏':'收藏'}}</text></view><view data-event-opts="{{[['tap',[['toggleExperienced',['$event']]]]]}}" class="{{['bottom-icon-item','data-v-4cbe6322',(isExperienced)?'bottom-icon-item--active':'']}}" bindtap="__e"><image class="{{['bottom-icon-img','data-v-4cbe6322',(isExperienced)?'bottom-icon-img--active':'']}}" src="/static/assets/体验.png" mode="aspectFit"></image><text class="bottom-label data-v-4cbe6322">{{isExperienced?'已体验':'体验'}}</text></view><button class="bottom-icon-item data-v-4cbe6322" open-type="share" data-event-opts="{{[['tap',[['shareScenic',['$event']]]]]}}" catchtap="__e"><image class="bottom-icon-img data-v-4cbe6322" src="/static/assets/分享2.png" mode="aspectFit"></image><text class="bottom-label data-v-4cbe6322">分享</text></button></view><view class="bottom-right data-v-4cbe6322"><view data-event-opts="{{[['tap',[['openAddToListDialog',['$event']]]]]}}" class="add-to-list-btn data-v-4cbe6322" bindtap="__e"><text class="add-to-list-text data-v-4cbe6322">加入清单</text><image class="add-to-list-ic