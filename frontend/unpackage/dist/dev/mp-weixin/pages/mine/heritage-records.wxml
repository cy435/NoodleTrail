<page-meta page-style="overflow:auto;min-height:100vh" class="data-v-2bb28007"></page-meta><view class="heritage-records-page data-v-2bb28007"><view class="page-header data-v-2bb28007"><text class="page-title data-v-2bb28007">🎭 非遗体验记录</text><view class="stats-row data-v-2bb28007"><view class="stat-item data-v-2bb28007"><text class="stat-value data-v-2bb28007">{{records.experiencedCount}}</text><text class="stat-label data-v-2bb28007">已体验</text></view><view class="stat-divider data-v-2bb28007"></view><view class="stat-item data-v-2bb28007"><text class="stat-value data-v-2bb28007">{{records.favoriteCount}}</text><text class="stat-label data-v-2bb28007">已收藏</text></view></view></view><view class="tabs data-v-2bb28007"><view data-event-opts="{{[['tap',[['switchTab',['experienced']]]]]}}" class="{{['tab-item','data-v-2bb28007',(activeTab==='experienced')?'active':'']}}" bindtap="__e"><text class="tab-text data-v-2bb28007">{{"已体验 ("+records.experiencedCount+")"}}</text></view><view data-event-opts="{{[['tap',[['switchTab',['favorite']]]]]}}" class="{{['tab-item','data-v-2bb28007',(activeTab==='favorite')?'active':'']}}" bindtap="__e"><text class="tab-text data-v-2bb28007">{{"已收藏 ("+records.favoriteCount+")"}}</text></view></view><block wx:if="{{loading}}"><view class="loading data-v-2bb28007"><text class="data-v-2bb28007">加载中...</text></view></block><block wx:else><block wx:if="{{$root.g0===0}}"><view class="empty data-v-2bb28007"><text class="empty-text data-v-2bb28007">{{activeTab==='experienced'?'暂无体验记录':'暂无收藏记录'}}</text><text class="empty-hint data-v-2bb28007">去探索更多非遗项目吧~</text></view></block><block wx:else><scroll-view class="content-scroll data-v-2bb28007" scroll-y="{{true}}"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="__i0__" wx:key="id"><view data-event-opts="{{[['tap',[['goToDetail',['$0'],[[['currentList','id',item.$orig.id]]]]]]]}}" class="heritage-card data-v-2bb28007" bindtap="__e"><image class="heritage-image data-v-2bb28007" src="{{item.m0