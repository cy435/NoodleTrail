.heritage-records-page.data-v-2bb28007 {
  min-height: 100vh;
  background: linear-gradient(180deg, #fffaf1 0%, #fff5dc 100%);
  color: #5a2c12;
  font-family: "LXGW WenKai Screen", "PingFang SC", system-ui;
  padding-bottom: 40rpx;
}
.page-header.data-v-2bb28007 {
  padding: 32rpx 28rpx 24rpx;
  background: linear-gradient(135deg, #ffb74d 0%, #ff9800 100%);
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.3);
}
.page-title.data-v-2bb28007 {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 16rpx;
}
.stats-row.data-v-2bb28007 {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}
.stat-item.data-v-2bb28007 {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.stat-value.data-v-2bb28007 {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
}
.stat-label.data-v-2bb28007 {
