<page-meta page-style="overflow:auto;min-height:100vh" class="data-v-73406a40"></page-meta><view class="checklists-page data-v-73406a40"><view class="page-header data-v-73406a40"><text class="page-title data-v-73406a40">📋 我的清单大全</text><text class="page-subtitle data-v-73406a40">{{"共 "+totalCount+" 个清单"}}</text></view><block wx:if="{{loading}}"><view class="loading data-v-73406a40"><text class="data-v-73406a40">加载中...</text></view></block><block wx:else><block wx:if="{{$root.g0===0}}"><view class="empty data-v-73406a40"><text class="empty-text data-v-73406a40">暂无清单记录</text><text class="empty-hint data-v-73406a40">去创建你的第一个清单吧~</text></view></block><block wx:else><scroll-view class="content-scroll data-v-73406a40" scroll-y="{{true}}"><block wx:for="{{$root.l2}}" wx:for-item="group" wx:for-index="dateIndex" wx:key="date"><view class="date-group data-v-73406a40"><view class="date-header data-v-73406a40"><text class="date-text data-v-73406a40">{{group.m0}}</text><text class="date-count data-v-73406a40">{{group.g1+" 个清单"}}</text></view><block wx:for="{{group.l1}}" wx:for-item="checklist" wx:for-index="index" wx:key="id"><view class="checklist-card data-v-73406a40"><view class="card-header data-v-73406a40"><text class="checklist-name data-v-73406a40">{{checklist.$orig.name||'未命名清单'}}</text><text class="checklist-order data-v-73406a40">{{"第 "+(checklist.$orig.order||index+1)+" 个"}}</text></view><block wx:if="{{checklist.g2}}"><view class="items-preview data-v-73406a40"><block wx:for="{{checklist.l0}}" wx:for-item="item" wx:for-index="itemIndex"><view class="item-preview data-v-73406a40"><text class="{{['item-check','data-v-73406a40',(item.checked)?'checked':'']}}">{{item.checked?'✓':'○'}}</text><text class="{{['item-content','data-v-73406a40',(item.checked)?'item-checked':'']}}">{{item.content}}</text></view></block><block wx:if="{{checklist.g3>3}}"><text class="more-items data-v-73406a40">{{"还有 "+(checklist.g4-3)+" 项..."}}</text></block></view></block><block wx:else><view c