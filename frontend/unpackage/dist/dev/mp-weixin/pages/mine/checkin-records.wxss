.checkin-records-page.data-v-31c76fdf {
  min-height: 100vh;
  background: linear-gradient(180deg, #fffaf1 0%, #fff5dc 100%);
  color: #5a2c12;
  font-family: "LXGW WenKai Screen", "PingFang SC", system-ui;
  padding-bottom: 40rpx;
}
.page-header.data-v-31c76fdf {
  padding: 32rpx 28rpx 24rpx;
  background: linear-gradient(135deg, #ffb74d 0%, #ff9800 100%);
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.3);
}
.page-title.data-v-31c76fdf {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}
.page-subtitle.data-v-31c76fdf {
  display: block;
  font-size: 24rpx;
  color: #fff9e6;
}
.loading.data-v-31c76fdf, .empty.data-v-31c76fdf {
  padding: 120rpx 28rpx;
  text-align: center;
}
.empty-text.data-v-31c76fdf {
  display: block;
  font-size: 28rpx;
  color: #8c5c2a;
  margin-bottom: 12rpx;
}
.empty-hint.data-v-31c76fdf {
  display: block;
  font-size: 24rpx;
  color: #999;
}
.content-scroll.data-v-31c76fdf {
  height: calc(100vh - 200rpx);
  padding: 20rpx 30rpx 20rpx 10rpx;
}
.checkin-card.data-v-31c76fdf {
  background: #fff5e6;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 20rpx 20rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 3rpx solid #e8d4b8;
  position: relative;
}
.images-row.data-v-31c76fdf {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.checkin-image.data-v-31c76fdf {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f0e6d8;
}
.content-section.data-v-31c76fdf {
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx dashed #cfa86a;
}
.checkin-content.data-v-31c76fdf {
  font-size: 32rpx;
  color: #5a2c12;
  line-height: 1.6;
  display: block;
}
.meta-section.data-v-31c76fdf {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.meta-bottom-row.data-v-31c76fdf {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.delete-checkin-btn.data-v-31c76fdf {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  background: #7b2f00;
  border-radius: 999px;
  padding: 2rpx 10rpx;
}
.delete-checkin-text.data-v-31c76fdf {
  font-size: 22rpx;
  color: #ffffff;
}
.location-info.data-v-31c76fdf, .time-info.data-v-31c76fdf {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.location-icon.data-v-31c76fdf, .time-icon.data-v-31c76fdf {
  font-size: 24rpx;
  flex-shrink: 0;
}
.location-text.data-v-31c76fdf, .time-text.data-v-31c76fdf {
  font-size: 24rpx;
  color: #8c5c2a;
  flex: 1;
}
